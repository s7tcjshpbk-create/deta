<!DOCTYPE html>
<html lang="uk">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Важливе питання</title>
  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }

    body {
      display: flex;
      justify-content: center;
      align-items: center;
      min-height: 100vh;
      background: linear-gradient(135deg, #ff9a9e 0%, #fecfef 100%);
      text-align: center;
      padding: 20px;
    }

    .card {
      background: white;
      padding: 40px 30px;
      border-radius: 20px;
      box-shadow: 0 10px 25px rgba(0,0,0,0.1);
      max-width: 450px;
      width: 100%;
      position: relative;
    }

    h1 {
      color: #333;
      margin-bottom: 30px;
      font-size: 26px;
    }

    .buttons {
      display: flex;
      justify-content: center;
      gap: 20px;
      min-height: 60px;
      position: relative;
    }

    button {
      padding: 12px 28px;
      font-size: 18px;
      font-weight: bold;
      border: none;
      border-radius: 12px;
      cursor: pointer;
      transition: transform 0.2s, background-color 0.2s;
    }

    #btn-yes {
      background-color: #ff4b2b;
      color: white;
    }

    #btn-yes:hover {
      background-color: #ff416c;
      transform: scale(1.05);
    }

    #btn-no {
      background-color: #e0e0e0;
      color: #555;
      position: absolute;
      transition: all 0.15s ease;
    }

    /* Стилі для кроку 2 (Варіанти відповідей) */
    .options {
      display: none;
      flex-direction: column;
      gap: 12px;
      margin-top: 20px;
    }

    .option-btn {
      background-color: #f8f9fa;
      border: 2px solid #ff4b2b;
      color: #333;
      padding: 12px;
      border-radius: 10px;
      font-size: 16px;
      cursor: pointer;
    }

    .option-btn:hover {
      background-color: #ff4b2b;
      color: white;
    }

    .hidden {
      display: none;
    }
  </style>
</head>
<body>

  <div class="card">
    <!-- Крок 1: Запитання -->
    <div id="step-1">
      <h1>Ти підеш зі мною на побачення? 🌹</h1>
      <div class="buttons">
        <button id="btn-yes">Так!</button>
        <button id="btn-no">Ні</button>
      </div>
    </div>

    <!-- Крок 2: Варіанти -->
    <div id="step-2" class="hidden">
      <h1>Ура! Куди підемо? ✨</h1>
      <div class="options" style="display: flex;">
        <button class="option-btn" onclick="selectOption('Більярд')">🎱 Більярд</button>
        <button class="option-btn" onclick="selectOption('Прогулятися')">🌳 Прогулятися</button>
        <button class="option-btn" onclick="selectOption('В кіно')">🍿 Піти в кіно</button>
        <button class="option-btn" onclick="selectOption('Кудись поїсти')">🍕 Кудись поїсти</button>
      </div>
    </div>

    <!-- Крок 3: Фінал -->
    <div id="step-3" class="hidden">
      <h1 id="final-message"></h1>
      <p style="font-size: 18px; color: #555; margin-top: 10px;">До зустрічі! 😉</p>
    </div>
  </div>

  <script>
    const btnNo = document.getElementById('btn-no');
    const btnYes = document.getElementById('btn-yes');
    const step1 = document.getElementById('step-1');
    const step2 = document.getElementById('step-2');
    const step3 = document.getElementById('step-3');
    const finalMessage = document.getElementById('final-message');

    // Початкове позиціонування кнопки "Ні"
    btnNo.style.right = '40px';

    // Втікаюча кнопка "Ні"
    function moveButton() {
      const card = document.querySelector('.card');
      const cardRect = card.getBoundingClientRect();
      const btnRect = btnNo.getBoundingClientRect();

      // Обчислюємо випадкові координати в межах картки
      const maxX = cardRect.width - btnRect.width - 40;
      const maxY = cardRect.height - btnRect.height - 40;

      const randomX = Math.floor(Math.random() * maxX);
      const randomY = Math.floor(Math.random() * maxY);

      btnNo.style.position = 'absolute';
      btnNo.style.left = `${randomX}px`;
      btnNo.style.top = `${randomY}px`;
    }

    // Події для мишки та сенсорних екранів (телефонів)
    btnNo.addEventListener('mouseover', moveButton);
    btnNo.addEventListener('touchstart', (e) => {
      e.preventDefault(); // Запобігає кліку на мобільному
      moveButton();
    });

    // Натискання на "Так"
    btnYes.addEventListener('click', () => {
      step1.classList.add('hidden');
      step2.classList.remove('hidden');
    });

    // Вибір варіанту відпочинку
    function selectOption(choice) {
      step2.classList.add('hidden');
      step3.classList.remove('hidden');
      finalMessage.innerText = `Чудовий вибір: ${choice}! 🎉`;
    }
  </script>
</body>
</html>
